# Copy to apps/api/.env. Local development values only; never commit real secrets.
DATABASE_URL=postgresql+asyncpg://app:local@localhost:5432/nu_hub
TEST_DATABASE_URL=postgresql+asyncpg://app:local@localhost:5432/nu_hub_test
SESSION_SECRET=replace_with_random_local_secret
WEB_ORIGIN=http://localhost:8080
EMAIL_PROVIDER_API_KEY=replace_if_needed
# Illustrative model; evaluate cost, licensing and relevance before relying on it.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
