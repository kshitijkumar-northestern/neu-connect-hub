# Copy to apps/api/.env. Local development values only; never commit real secrets.
DATABASE_URL=postgresql+asyncpg://app:local@localhost:5432/nu_hub
TEST_DATABASE_URL=postgresql+asyncpg://app:local@localhost:5432/nu_hub_test
SESSION_SECRET=replace_with_random_local_secret
WEB_ORIGIN=http://localhost:8080
# Comma-separated campus email domains allowed to register.
ALLOWED_EMAIL_DOMAINS=northeastern.edu
# "dev" writes emails to apps/api/.dev-mail/ (gitignored); production needs "smtp" plus SMTP_HOST.
MAIL_BACKEND=dev
EMAIL_PROVIDER_API_KEY=replace_if_needed
# Illustrative model; evaluate cost, licensing and relevance before relying on it.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# Calls: STUN/TURN servers (comma-separated); empty is fine locally, where browsers connect directly.
STUN_URLS=
TURN_URLS=
# Signs short-lived TURN credentials (coturn's use-auth-secret); required in production with TURN_URLS.
TURN_SECRET=replace_if_needed
# Signs Scan to Connect QR links; required in production (32+ characters, not SESSION_SECRET).
SHARE_TOKEN_SECRET=replace_if_needed
